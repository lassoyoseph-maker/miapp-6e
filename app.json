{
  "expo": {
    "name": "La Vitrina Muebles",
    "slug": "miapp-6e",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/vitrina-icon.png",
    "scheme": "miapp6e",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EC",
        "foregroundImage": "./assets/images/vitrina-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lassoyoseph.lavitrina"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/vitrina-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F3EC",
          "image": "./assets/images/vitrina-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc61ef20-969c-4814-b197-c1b761d3d7c8"
      }
    },
    "owner": "lassoyoseph"
  }
}
